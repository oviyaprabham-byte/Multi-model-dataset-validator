# LLM Configuration for Dataset Validator AI Agent
# Copy this file to .env and fill in your values.
# If you do NOT configure an LLM, voice reading still works fully.
# Q&A will use a rule-based fallback instead of AI.

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Options: none | openai | anthropic | google | ollama
LLM_PROVIDER=none

# ── API Key ───────────────────────────────────────────────────────────────────
# Required for openai, anthropic, and google providers.
# Leave empty for ollama (uses local server) or none.
LLM_API_KEY=

# ── Model Name ────────────────────────────────────────────────────────────────
# openai:    gpt-4o-mini  |  gpt-4o  |  gpt-3.5-turbo
# anthropic: claude-3-haiku-20240307  |  claude-3-5-sonnet-20241022
# google:    gemini-1.5-flash  |  gemini-1.5-pro
# ollama:    llama3  |  mistral  |  phi3
LLM_MODEL=

# ── Ollama (optional) ─────────────────────────────────────────────────────────
# Base URL for local Ollama server. Default: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
